@page "/filamentos"
@rendermode InteractiveServer

@using GestaoLoja3D.Dominio.Data
@using GestaoLoja3D.Dominio.Models
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext

<h1>Filamentos</h1>

<h3>Nova remessa</h3>

<form>
    <div class="mb-2">
        <label>Tipo de Material</label>
        <input class="form-control" @bind="tipoMaterial" />
    </div>
    <div class="mb-2">
        <label>Cor</label>
        <input class="form-control" @bind="cor" />
    </div>
    <div class="mb-2">
        <label>Marca</label>
        <input class="form-control" @bind="marca" />
    </div>
    <div class="mb-2">
        <label>Quantidade Comprada (kg)</label>
        <input class="form-control" @bind="quantidadeComprada" type="number" step="0.01" />
    </div>
    <div class="mb-2">
        <label>Preço Pago (R$)</label>
        <input class="form-control" @bind="valorTotal" type="number" step="0.01" />
    </div>
    <button class="btn btn-primary" type="button" @onclick="Salvar">Salvar</button>
</form>
@if (!string.IsNullOrEmpty(mensagemErro))
{
	<div class="alert alert-danger mt-2">@mensagemErro</div>
}

<hr />

<h3>Remessas cadastradas</h3>

<table class="table">
    <thead>
        <tr>
            <th>Tipo</th>
            <th>Cor</th>
            <th>Marca</th>
            <th>Comprado (kg)</th>
            <th>Disponível (kg)</th>
            <th>Preço/kg</th>
            <th>Data</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var filamento in listaFilamento)
        {
            <tr>
                <td>@filamento.TipoMaterial</td>
                <td>@filamento.Cor</td>
                <td>@filamento.Marca</td>
                <td>@filamento.QuantidadeComprada</td>
                <td>@filamento.QuantidadeDisponivel</td>
                <td>@filamento.ValorPorUnidade().ToString("C")</td>
                <td>@filamento.Data.ToString("dd/MM/yyyy")</td>
            </tr>
        }
    </tbody>
</table>

@code
{
    string tipoMaterial;
    string cor;
    string marca;
    decimal quantidadeComprada;
    decimal valorTotal;

	string mensagemErro;

    private List<Filamento> listaFilamento = new List<Filamento>();

    protected override async Task OnInitializedAsync()
    {
        listaFilamento = await DbContext.Filamentos.ToListAsync();
    }

    private async Task Salvar()
    {
        try
        {
            mensagemErro = string.Empty;

            var filamento = new Filamento(tipoMaterial, cor, marca, quantidadeComprada, valorTotal);
            DbContext.Filamentos.Add(filamento);
            await DbContext.SaveChangesAsync();
            // Atualiza a lista de filamentos após salvar
            listaFilamento = await DbContext.Filamentos.ToListAsync();
            // Limpa os campos do formulário
            tipoMaterial = string.Empty;
            cor = string.Empty;
            marca = string.Empty;
            quantidadeComprada = 0;
            valorTotal = 0;
        }
        catch (ArgumentException ex)
        {
			mensagemErro = ex.Message;
        }
        

        
	}
}